# Isolated Hermes test profile — ONLY the Gateway token lives here.
# Copy into  $HERMES_HOME/.env  (see enable-routing.sh, which does this for you).
#
# There must be NO real provider key (OpenAI / Anthropic / OpenRouter / ...) in
# this file or anywhere in the Hermes profile. The real key lives only in the
# Gateway's own .env.

OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_KEY=hermes-to-gateway-token-CHANGE_ME
