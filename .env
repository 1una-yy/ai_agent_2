# ------------------------------------------------------------------------------
# DCISO Governance Gateway — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# ------------------------------------------------------------------------------

# --- Upstream model provider (the ONLY place a real provider key may live) ------
# Demo uses OpenAI. This key is used by the Gateway to reach the real provider,
# and by the CISO advisor service when CISO_MODE=llm. Hermes must NOT have it.
OPENAI_API_KEY=

# `dciso gemini` uses Google Gemini instead (no OpenAI key needed for that mode).
GEMINI_API_KEY=AQ.Ab8RN6IdzI9MNxJCIyFS9Dsw3jrfqIoZJ0gc7eOvDuXZsmntdQ

# Model IDs are provider-current values; verify against the provider's current
# model list before running. `dciso demo` reads this for the OpenAI model id;
# `dciso gemini` always overrides it with GEMINI_MODEL below, so it's safe to
# leave this pointed at OpenAI.
GATEWAY_UPSTREAM_MODEL=openai/gpt-4o
CISO_LLM_MODEL=openai/gpt-4o-mini
GEMINI_MODEL=gemini/gemini-3.8-flash

# --- Token Hermes uses to authenticate TO the Gateway (not a provider key) -----
# Any opaque string. Hermes' isolated profile gets ONLY this.
GATEWAY_MASTER_KEY=gw-aeJSpNgLwAcK_QQr2sph4TMbHTDHH2AF

# --- Which upstream the Gateway routes `governed-model` to ---------------------
# demo  -> real OpenAI (needs OPENAI_API_KEY)
# test  -> local mock-llm service (offline, deterministic)
# ollama -> local/remote Ollama instance
GATEWAY_ROUTE_MODE=test

# --- CISO advisor -------------------------------------------------------------
# rule -> deterministic offline rule engine (default for tests/e2e)
# llm  -> real OpenAI-backed advisor (Demo)
CISO_MODE=rule
CISO_TIMEOUT_SECONDS=4

# --- OPA (Hard PDP) ---------------------------------------------------------
OPA_URL=http://opa:8181
OPA_DECISION_PATH=dciso/governance/decision
OPA_TIMEOUT_SECONDS=3

# --- Audit store ----------------------------------------------------------------
AUDIT_DB_PATH=/data/audit.sqlite

# --- Enforcement tuning -------------------------------------------------------
REPLAN_MAX_ATTEMPTS=2

# HMAC secret for human-approval tokens (REQUIRE_REVIEW release path).
# If empty, NO token can ever release a review — the safe default.
# Set the SAME value here and wherever tokens are minted (demo/mint-approval.py).
GOVERNANCE_APPROVAL_SECRET=PVieBQjQuEYKSSj62jyS3ipA7f-OyKfgapORgG0SisI

# Set to 1 ONLY to allow ungoverned streaming (not recommended; MVP governs
# non-streaming only, so streaming is refused fail-closed by default).
ALLOW_UNGOVERNED_STREAMING=0

# --- Dashboard (viewer) -------------------------------------------------------
# Bound to localhost only by compose; do not expose publicly.
VIEWER_BIND=127.0.0.1:8900

OLLAMA_BASE_URL=http://192.168.47.77:11435
OLLAMA_MODEL=gpt-oss:120b
