# ==============================================================================
# DCISO 治理閘道 — 環境設定樣板
# `dciso setup` 會把這個檔案複製成 `.env`，然後編輯 `.env`（不是這個檔）。
# `.env` 只存在你這台機器，不要外流、不要提交到版本庫。
# ==============================================================================
#
# ★ 你「一定要填」的，只有下面這 1～2 行（其餘保持預設即可）：
#     OLLAMA_BASE_URL   → 你的 Ollama 主機網址   （用 Ollama 當業務模型時）
#     OPENAI_API_KEY    → 你的 OpenAI 金鑰        （改用 OpenAI 當業務模型時）
#
# 其他機密（GATEWAY_MASTER_KEY、GOVERNANCE_APPROVAL_SECRET）由 `dciso setup`
# 自動產生，留空即可。
# ------------------------------------------------------------------------------

# --- 用 OpenAI 當業務模型時才填（GATEWAY_ROUTE_MODE=demo）----------------------
# 這把金鑰只有閘道 / CISO(llm 模式) 會用；被治理的 agent 絕對不會拿到。
# 例：  OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 用 Ollama 的話這行留空即可。
OPENAI_API_KEY=
GATEWAY_UPSTREAM_MODEL=openai/gpt-4o
CISO_LLM_MODEL=openai/gpt-4o-mini

# --- 用 Google Gemini 當業務模型時才填（`dciso gemini`，GATEWAY_ROUTE_MODE=gemini）---
# 免費方案每日額度很低（一般 free tier 是每天 20 次請求），僅供快速驗證用，
# 正式/長時間使用請升級付費方案或改用 Ollama / OpenAI。
# 例：  GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=
# 預設 gemini/gemini-3.8-flash；要換型號才需要改這行。
GEMINI_MODEL=gemini/gemini-3.8-flash

# --- 用登入（無靜態金鑰）時才填（GATEWAY_ROUTE_MODE=proxy）--------------------
# `dciso login` 之後 `dciso up-proxy`。一般使用者用不到，可略過。
HERMES_PROXY_URL=http://host.docker.internal:8645/v1
UPSTREAM_MODEL=openai/upstage/solar-pro4:free
CISO_LLM_BASE_URL=
CISO_LLM_MODEL_PROXY=openai/stepfun/step-3.7-flash:free

# --- 用區網 / 本機 Ollama 當業務模型（GATEWAY_ROUTE_MODE=ollama）★常用★ -------
# 填你的 Ollama 主機網址，結尾不要加斜線。閘道容器會直接連這個位址。
# 例：  OLLAMA_BASE_URL=http://192.0.2.10:11434
#       （192.0.2.10 是示範用 IP，請換成你自己 Ollama 主機的 IP）
# 填的時候整行只留 `OLLAMA_BASE_URL=你的網址`，不要在後面接註解。
OLLAMA_BASE_URL=
# 換成你 Ollama 上有、而且支援 tools 的模型名——這是「被治理的 agent 沒指定模型時」的預設值。
OLLAMA_MODEL=gpt-oss:120b
# 預設會自動查詢這台 Ollama 主機上「所有」支援 tools 的模型，各自多開一個可選項，
# 讓被治理的 Hermes 自己換模型（例如用 /model 選單）——全部都還是連到上面這個
# OLLAMA_BASE_URL、治理邏輯完全一樣，只是模型 ID 可以自己選。設成 0 只留單一固定模型。
OLLAMA_EXPOSE_ALL_MODELS=1

# --- agent 用來對「閘道」認證的 token（不是模型金鑰）------------------------
# 留空 —— `dciso setup` 會自動產生一串隨機值。
GATEWAY_MASTER_KEY=

# --- 閘道把 `governed-model` 導到哪個上游 -----------------------------------
# demo -> 真的 OpenAI（要 OPENAI_API_KEY）｜ gemini -> Google Gemini（要 GEMINI_API_KEY）
# ollama -> 區網/本機 Ollama ｜ test -> 本機假模型（離線）
# 用 `dciso demo` / `dciso gemini` / `dciso up-ollama` 時這行會被自動設好，不用手動改。
GATEWAY_ROUTE_MODE=test

# --- 要治理哪些 agent ------------------------------------------------------
# 留 "hermes" = 沒帶 harness 標記的請求當成 Hermes。
# 設成空字串 = 通用模式，治理任何 OpenAI 相容用戶端（`--agent generic` 會自動設空）。
GATEWAY_DEFAULT_HARNESS=hermes
# DCISO_GENERIC_ADAPTER=0 disables the catch-all (non-Hermes -> UNKNOWN_HARNESS)
DCISO_GENERIC_ADAPTER=1

# --- output-side governance (Phase A) ---------------------------------------
# Govern a model's final answer before delivery. Fast path: clean scan +
# non-sensitive task + non-external recipient -> ALLOW without the CISO.
# Otherwise OPA decides on scan signals (credential/forbidden counts, recipient
# class) — never the raw text. Policy body lives in policy/data.json
# (output_policy). DCISO_OUTPUT_GATE=0 turns the whole phase off.
DCISO_OUTPUT_GATE=1
DCISO_OUTPUT_MAX_SCAN=200000

# --- egress-side governance (Phase B) --------------------------------------
# Govern a tool result before it is sent to a model endpoint. Destination
# class: local / approved / external — resolved from the REAL upstream host
# (the gateway's actual GATEWAY_UPSTREAM_API_BASE) via a private/loopback-IP
# check, NOT from GATEWAY_ROUTE_MODE (that's just an operator label, not a
# verified network fact). Fast path: local dest + clean scan + not oversize
# -> forwarded untouched.
DCISO_EGRESS_GATE=1
# DCISO_EGRESS_DEST_CLASS=            # force local|approved|external, skips all the checks below
# DCISO_APPROVED_HOSTS=               # comma-separated hostnames -> dest_class=approved (not local, not external)
# DCISO_FORCE_EXTERNAL_HOSTS=         # comma-separated hostnames -> ALWAYS dest_class=external even if the IP is private.
#   Use this for a LAN proxy/relay that itself forwards your requests on to a
#   cloud model — the gateway only sees that first (private-IP) hop, so
#   without this it would be wrongly trusted as "local" and the strict
#   external-class protections (block_sensitive_fields etc.) would never apply.

# --- execution-side path policy (Phase C) ---------------------------------
# denied_markers / execute_from_markers / interpreters live in
# policy/data.json path_policy. To enable the "writes must stay in the
# workspace" check, set path_policy.workspace_roots there (a write/delete
# outside them -> REQUIRE_REVIEW). Applies at both the proposal and the
# execution-pre-dispatch phase.
# extra tool names that mean "spawn a sub-agent" (comma separated)
DCISO_DELEGATION_TOOLS=

# --- CISO advisor -------------------------------------------------------------
# hermes -> the advisor IS a separate tool-less Hermes instance (host sidecar
#           :9009). THIS IS THE DEFAULT for `dciso up-ollama`.
# rule   -> deterministic offline rule engine. Used by `dciso up` (offline
#           test / guided demo — no model available) and CI. Opt in on the
#           real-model path with `dciso up-ollama <model> --ciso rule`.
# llm    -> one direct model call (set CISO_LLM_* below). `--ciso llm`.
# NB: `dciso up-ollama` ignores this var (always hermes unless --ciso given);
#     `dciso up` / compose fall back to rule.
CISO_MODE=rule
CISO_TIMEOUT_SECONDS=4
# Phase D — a CISO advice of REQUIRE_REVIEW/MODIFY, or risk_score >= this floor,
# is recorded as a non-binding advisory on an otherwise-ALLOW decision
# (dashboard: "資安長示警·已放行"). It never changes the outcome.
CISO_ADVISORY_SCORE_MIN=50

# CISO_MODE=hermes knobs (host sidecar reads these; dciso sets sane defaults):
CISO_HERMES_HOME=                 # default ~/.hermes-ciso
CISO_HERMES_MODEL=gemma4:31b      # direct to OLLAMA_BASE_URL, NOT the gateway
CISO_HERMES_FALLBACK=rule         # rule -> rule engine on timeout/error; deny -> fail closed
CISO_HERMES_TIMEOUT=60            # seconds to wait for the `hermes -z` one-shot
CISO_HERMES_SKILLS=              # comma list of advice-only skills to activate
                                 #   (installed in ~/.hermes-ciso/skills/). Skills
                                 #   are instruction packs; the CISO stays tool-less.

# --- OPA (Hard PDP) ---------------------------------------------------------
OPA_URL=http://opa:8181
OPA_DECISION_PATH=dciso/governance/decision
OPA_TIMEOUT_SECONDS=3

# --- Audit store ----------------------------------------------------------------
AUDIT_DB_PATH=/data/audit.sqlite

# --- Enforcement tuning -------------------------------------------------------
REPLAN_MAX_ATTEMPTS=2

# 人工核准 token 的 HMAC 金鑰（REQUIRE_REVIEW 的放行路徑）。
# 留空 = 沒有任何 token 能放行審核（安全預設）。`dciso setup` 會自動產生。
GOVERNANCE_APPROVAL_SECRET=

# 串流回覆一樣會被治理（緩衝後過同一套管線）。設 1 才會略過。
ALLOW_UNGOVERNED_STREAMING=0

# --- Dashboard (viewer) -------------------------------------------------------
# Bound to localhost only by compose; do not expose publicly.
VIEWER_BIND=127.0.0.1:8900
